# Copy to .env.local and restart. GOOGLE_APPLICATION_CREDENTIALS is required; everything else is optional.

# Move every port Studio uses, when one is taken. 100 puts Studio on 5700 and MCP on 5733.
# AINOBI_PORT_OFFSET=100

# Required: narration, and AI scoring of essays and recordings (Gemini on Google Cloud Vertex AI).
# A service account key file with the Vertex AI User role; a relative path is read from this folder. See docs/google-cloud.md.
GOOGLE_APPLICATION_CREDENTIALS=.ainobi/gcp-key.json
# The project defaults to the service account's own; set it only to use another.
# GOOGLE_CLOUD_PROJECT=

# Other narration voices. MiniMax and Fish Audio voices are listed as inactive unless you use them already.
# FISH_AUDIO_API_KEY=
# MINIMAX_API_KEY=

# Generating AI teachers. OPENAI_API_KEY below is enough; set these only for another OpenAI compatible
# provider, or a separate key. OPENAI_API_KEY is never sent to a custom LLM_API_BASE.
# LLM_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# AVATAR_IMAGE_MODEL=gpt-image-2.5-sunburst
# AVATAR_VISION_MODEL=gpt-5.6

# The AI assistant in the editor, through an Anthropic compatible API.
# Its panel stays hidden until both the key and the URL are set. Restart Studio after changing them.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# Web search and image generation, only for agents that cannot search or draw themselves.
# OPENAI_API_KEY also lets people generate AI teachers from Studio's home page.
# TAVILY_API_KEY=
# OPENAI_API_KEY=

# Sites allowed to embed Studio, comma separated.
# AINOBI_EMBED_ORIGINS=https://your-site.example

# Where stored objects go, instead of .ainobi/storage.
# AINOBI_STORAGE_DIR=
