# 阿里云账户ID
ALIYUN_ACCOUNT_ID=5373477951171581
# 阿里云访问Key ID（在云函数上无需设置，会自动取系统提供的认证信息）
ALIYUN_ACCESS_KEY_ID=
# 阿里云访问Key Secret（在云函数上无需设置，会自动取系统提供的认证信息）
ALIYUN_ACCESS_KEY_SECRET=
# 阿里函数地域
ALIYUN_FC_REGION=ap-northeast-1
# 阿里云函数名称
ALIYUN_FC_FUNCTION_NAME=ainobi-courseware-service
# 阿里云函数别名（yarn release / release:prod → prod；yarn release:test → test）
ALIYUN_FC_FUNCTION_ALIAS=prod
# 也可通过 CLI 覆盖：node scripts/publish.js --alias test --version latest
# 阿里云函数生产域名（可以为多个，用逗号分隔）
ALIYUN_FC_PROD_DOMAIN=courseware-api.example.com
# 阿里云函数测试域名（可以为多个，用逗号分隔）
ALIYUN_FC_TEST_DOMAIN=courseware-api.example.com
# 阿里云函数路由路径（可以为多个，用逗号分隔）
# 智能体产品：/agent/[function_name]/*
# API产品：/api/[function_name]/*
# 大模型产品：/llm/[function_name]/*
ALIYUN_FC_ROUTE_PATH=/*

# 指定时区
TZ=Asia/Shanghai

# 服务端口
PORT=5633

# AINOBI 平台 HTTP API 根路径（鉴权、扣费、组织列表等路径在代码中拼接）
AINOBI_BACKEND_API_BASE=http://localhost:8000/v1
# Courseware service -> education backend internal projection token.
# Must match backend COURSEWARE_SERVICE_INTERNAL_TOKEN.
COURSEWARE_SERVICE_INTERNAL_TOKEN=
COURSEWARE_QUIZ_PROJECTION_RETRIES=3
# Agent 按 token 扣费时使用的平台 service_code（与 ANTHROPIC_MODEL 分离；未设置则跳过扣费）
AINOBI_MODEL_CREDITS_SERVICE_CODE=deepseek-v4.1-flash
# 实际上游 API 的模型 id（表面仍用 ANTHROPIC_MODEL / 扣费仍用 AINOBI_MODEL_CREDITS_SERVICE_CODE）
# 例：表面 deepseek-v4.1-flash，API 走 deepseek-v4.1-flash-0731
# AINOBI_MODEL_API_ID=deepseek-v4.1-flash
# 也可按模型覆盖：AINOBI_DEEPSEEK_V4_FLASH_API_ID（deepseek-v4.1-flash 沿用该槽位）等
# Google Gemini TTS（默认提供商；ai_teacher_tts.tts_provider=google 或未配置时），走 Google Cloud Vertex AI 的 Interactions API
# 需要服务账号（该接口不接受 API Key），角色 Vertex AI User：GOOGLE_APPLICATION_CREDENTIALS（密钥文件）或 GOOGLE_APPLICATION_CREDENTIALS_JSON（内联）
# 项目默认取服务账号所属项目，可用 VERTEXAI_PROJECT_ID / GOOGLE_CLOUD_PROJECT 覆盖；VERTEXAI_BASE_URL 用于中转（CN 环境指向 FC relay 的 /vertexai 路由）
# GEMINI_TTS_LOCATION=global
# VERTEXAI_BASE_URL=
# GEMINI_TTS_PROXY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE_ID=kore
# GEMINI_TTS_MP3_BITRATE_KBPS=128
# GEMINI_TTS_SYNTHESIS_TIMEOUT_MS=180000
# Google TTS 扣费 service_code（默认 gemini-3.8-flash-tts，未配置也会计费）
# AINOBI_GOOGLE_TTS_CREDITS_SERVICE_CODE=gemini-3.8-flash-tts
# MiniMax TTS（旧；平台音色已隐藏，仅服务已绑定的旧教师）
MINIMAX_API_KEY=
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Gentleman
# Fish Audio TTS（旧；ai_teacher_tts.tts_provider=fishaudio 时使用，平台音色已隐藏）
FISH_AUDIO_API_KEY=
# FISH_AUDIO_TTS_MODEL=s1
# FISH_AUDIO_TTS_VOICE_ID=
# FISH_AUDIO_TTS_URL=https://api.fish.audio/v1/tts
# MiniMax TTS 扣费 service_code（ai_teacher_tts.tts_provider=minimax 时）
AINOBI_MINIMAX_CREDITS_SERVICE_CODE=speech-2.8-hd
# Fish Audio TTS 扣费 service_code（ai_teacher_tts.tts_provider=fishaudio 时）
AINOBI_FISHAUDIO_CREDITS_SERVICE_CODE=fishaudio-s2.1-pro
# Tavily 搜索按次计费（service_prices 中 CountBased，默认 service code: tavily-search）
AINOBI_TAVILY_CREDITS_SERVICE_CODE=tavily-search
# 每轮对话启动时预扣 token 数；结束时按 max(0, 总 token - 预扣) 再结算（默认 5000）
# AINOBI_CREDITS_PREAUTH_TOKENS=5000
# 扣费账户：organization
AINOBI_CREDITS_CONSUMPTION_TYPE=organization
# 同步失败后的重传次数（默认 3；总尝试 = 1 + 该值）
AINOBI_CREDITS_IMMEDIATE_RETRIES=3
# Redis 队列 Worker 轮询间隔（毫秒，默认 60000）
AINOBI_CREDITS_RETRY_INTERVAL_MS=60000
# 每轮 Worker 最多处理条数，防止积压冲垮平台（默认 5）
AINOBI_CREDITS_RETRY_BATCH_SIZE=5
# 队列重试指数退避基数（毫秒，默认 60000）
AINOBI_CREDITS_RETRY_BASE_BACKOFF_MS=60000
# 队列重试退避上限（毫秒，默认 1800000 = 30 分钟）
AINOBI_CREDITS_RETRY_MAX_BACKOFF_MS=1800000
# 同步扣费重试间隔基数/上限（毫秒）；预扣 preauth 默认更短：200ms 起、上限 2s
# AINOBI_CREDITS_IMMEDIATE_RETRY_BASE_MS=400
# AINOBI_CREDITS_IMMEDIATE_RETRY_MAX_MS=8000
# 本地调试跳过扣费
AINOBI_CREDITS_DISABLED=true
# Agent 旁白 TTS：由 chat 注入 http://127.0.0.1:${PORT}/courseware/narration/run（勿在沙箱手写）
# AINOBI_NARRATION_HOST_URL=http://127.0.0.1:5633/courseware/narration/run
# AINOBI_NARRATION_HOST_TIMEOUT_MS=600000
# Platform-level TTS pronunciation dictionary (backend table `tts_pronunciation`, same DB;
# applied below each org's own dictionary, and only when the AI teacher / voice
# language is Japanese). Cached in-process per instance.
# AINOBI_TTS_PLATFORM_DICT_DISABLED=false
# AINOBI_TTS_PLATFORM_DICT_CACHE_TTL_SECONDS=60
# Live preview scene.patch 合并窗口（毫秒，默认 250；0=每条 ainobi 命令立即 flush）
# AINOBI_LIVE_PREVIEW_FLUSH_DEBOUNCE_MS=250
# managed_list / organization/list 结果 Redis 缓存秒数（默认 300；两者共用该 TTL）
# AINOBI_ORG_MANAGED_LIST_CACHE_TTL_SECONDS=300

# 浏览器跨域（课件编辑器 localhost 等）；默认 *。业务请求仍需 Authorization: Bearer <access_token>
# CORS_ALLOW_ORIGIN=http://localhost:5173
# CORS_ALLOW_HEADERS=content-type, authorization, accept, x-requested-with

# 视频导出任务代理（/courseware/render/tasks*，转发到 ainobi-video-render-service）
# FC 双函数：query 负责 create/list/get/delete/retry；render 负责 run/cancel。
# create 时仍传 ainobi-render-task-id（任务 UUID）；render /run Async 自调用用其做会话亲和。
# 渲染服务 create 立即返回 queued，再自行 Async 调度 /run；本代理无需等待渲染完成。
#
# 生产环境（双函数）：
# AINOBI_VIDEO_RENDER_SERVICE_RENDER_URL=https://<render-function-http-trigger-or-gateway>
# AINOBI_VIDEO_RENDER_SERVICE_QUERY_URL=https://<query-function-http-trigger-or-gateway>
# 本地开发（单进程 all 角色）可只设 legacy 变量，渲染/查询共用同一地址：
AINOBI_VIDEO_RENDER_SERVICE_URL=http://localhost:5634
# 学生端前端 base URL，用于拼出无头渲染页地址 <base>/courseware-renderer?courseware_id=&render_token=
AINOBI_STUDENT_VIEW_BASE_URL=http://localhost:5173
# 本服务自身的 base URL（不带尾部斜杠），从 ainobi-video-render-service 的视角可达；
# 用于拼出创建渲染任务时传给它的 callbackUrl（<base>/courseware/render/callback）。
# 未设置时不影响渲染本身，但任务完成/失败/中断都不会主动回调，计费只能靠下方轮询兜底。
AINOBI_COURSEWARE_AGENT_BASE_URL=http://localhost:8001
# 签发 render_token（HMAC-SHA256）的密钥；未设置时使用不安全的开发默认值并打印警告。
# 生产环境务必设置，例如 `openssl rand -hex 32`
AINOBI_RENDER_TOKEN_SECRET=
# 双向共享密钥：调用 ainobi-video-render-service 时携带（x-ainobi-internal-token），
# 也用于校验它反向调用 /courseware/render/callback 时携带的同名 header。
# 本代理已在转发/接收前自行校验请求方对目标课件的读权限，替代普通用户会话 Bearer token
# （该服务的 course_section:query 权限与渲染任务管理无关，匿名可读的公开/分享课件请求
# 也没有用户 token 可转发）。必须与 ainobi-video-render-service 的
# AINOBI_VIDEO_RENDER_INTERNAL_TOKEN 保持一致，否则所有 /courseware/render/tasks* 请求
# 和 callback 都会失败。生产环境务必设置，例如 `openssl rand -hex 32`
# AINOBI_VIDEO_RENDER_INTERNAL_TOKEN=
# 视频导出按「各实例计算耗时之和」计费：
# prefer result.render.computeTakes（plan + Σchunk + assemble），旧任务回退 render.takes；
# ceil(ms/60000)，不足 1 按 1。与分布式并行墙钟脱钩，对齐 FC 总算力成本。
# 计费发生在创建任务的用户/组织的 access_token 下（下单时保存的凭据），成功完成后一次性结算，
# 由 callback（首选）或任务列表轮询（兜底，幂等）触发；失败/中断/取消/匿名请求不计费。
# AINOBI_VIDEO_RENDER_CREDITS_SERVICE_CODE=
# 导出视频/封面占用组织存储容量：完成后按 result.oss/cover.sizeBytes 计入，删除任务时释放。
# 与素材上传共用 AINOBI_ORG_STORAGE_* / 平台 /v1/organization/{orgId}/storage 接口。
# AINOBI_ORG_STORAGE_DISABLED=true 关闭全部组织存储对接；AINOBI_ORG_STORAGE_QUOTA_CHECK=false 仅跳过容量检查（不上锁/不计用量，上传不因配额失败）。
# AINOBI_ORG_STORAGE_DISABLED=
# AINOBI_ORG_STORAGE_QUOTA_CHECK=true

# Claude Code API 模型配置（编辑器可在请求体 `model` 覆盖；支持 deepseek-v4.1-flash、gpt-6-astra、gpt-6-sol、grok-4.6，见 src/services/agent-chat-models.ts）
# ANTHROPIC_MODEL：请求未指定 model 时的默认模型
ANTHROPIC_MODEL=deepseek-v4.1-flash
# 各模型独立 Anthropic-compatible 接入点（DeepSeek / Z.AI / Moonshot / xAI 等非 OpenRouter 平台时使用）
ANTHROPIC_DEEPSEEK_V4_FLASH_API_KEY=
ANTHROPIC_DEEPSEEK_V4_FLASH_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_GLM_5_2_API_KEY=
ANTHROPIC_GLM_5_2_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_KIMI_K3_API_KEY=
ANTHROPIC_KIMI_K3_BASE_URL=https://api.moonshot.ai/anthropic
ANTHROPIC_GLM_5_3_API_KEY=
ANTHROPIC_GLM_5_3_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_DEEPSEEK_V4_PRO_API_KEY=
ANTHROPIC_DEEPSEEK_V4_PRO_BASE_URL=https://api.deepseek.com/anthropic
# xAI Grok：官方无 Anthropic-compatible 端点（api.x.ai 仅 OpenAI 兼容协议）。
# BASE_URL 留空（推荐）→ 自动经内置 OpenAI↔Anthropic 协议桥调用（默认 127.0.0.1:5635）；
# 也可填其它 Anthropic 兼容接入点直连（如 OpenRouter 等聚合网关）
ANTHROPIC_GROK_4_6_API_KEY=
ANTHROPIC_GROK_4_6_BASE_URL=
# 协议桥上游 OpenAI 兼容地址（仅 BASE_URL 留空时生效）
ANTHROPIC_GROK_4_6_UPSTREAM_BASE_URL=https://api.x.ai/v1
# GPT-6 双子：官方仅 OpenAI 协议，经协议桥 gpt6 组（默认 127.0.0.1:5636）走
# 中转 relay 的 /openai/v1 responses 端点（原生支持 function tools + reasoning）。
# 未配置 ANTHROPIC_GPT6_UPSTREAM_BASE_URL 时 gpt-6 组不存在，模型不可用
# ANTHROPIC_GPT_6_ASTRA_API_KEY=
# ANTHROPIC_GPT_6_SOL_API_KEY=
# ANTHROPIC_GPT6_UPSTREAM_BASE_URL=
# gpt6 组上游凭证校验用的环境变量名（SDK 请求头透传，与 Grok 组同理）
# OPENAI_API_KEY=
# 协议桥可选项：AINOBI_ANTHROPIC_BRIDGE_HOST / AINOBI_ANTHROPIC_BRIDGE_PORT（默认 127.0.0.1:5635）；
# gpt6 组端口/模型：AINOBI_ANTHROPIC_BRIDGE_GPT6_PORT（默认 5636）/
# AINOBI_ANTHROPIC_BRIDGE_GPT6_MODELS（默认 gpt-6-astra,gpt-6-sol）；
# AINOBI_ANTHROPIC_BRIDGE_DISABLED=true 关闭（此时 grok-4.6 必须配置直连 BASE_URL）；
# 调试（勿在生产开）：AINOBI_ANTHROPIC_BRIDGE_RAW_TRACE_DIR=<目录> 时网关把原始
# 请求/上游链路包（body_full，含明文对话）落盘到该目录，用于排查协议转换问题
# 可选回退：OpenRouter 等共用 baseUrl+key 的平台，未配置上面的 per-model 变量时生效
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Vision API Key（宿主 `POST /courseware/doc/read` 图片→Markdown 描述；`POST /courseware/image/replicate-html` 图片→HTML 复刻；`POST /courseware/image/generate` 文本生图；`POST /courseware/prompt/optimize` 提示词优化；agent 通过 `ainobi doc read` / `ainobi image replicate-html` / `ainobi image generate` 委托，勿注入沙箱）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE=https://api.openai.com/v1
# 文本生图模型（OpenAI Images API，默认 gpt-image-2）
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# 提示词优化文本模型（默认回退到 OPENAI_MODEL）
# OPENAI_PROMPT_OPTIMIZE_MODEL=

# 生图/提示词优化计费 service_code（对接 ainobi-backend /v1/credits/consume）
# 生图默认 gpt-image-2（service_prices.csv 已内置）；提示词优化默认回退到 AINOBI_MODEL_CREDITS_SERVICE_CODE
# AINOBI_IMAGE_GENERATE_CREDITS_SERVICE_CODE=gpt-image-2
# MCP 生图预扣 token 数（生成前扣费；结束后按实际用量结算差额，默认 4000）
# AINOBI_IMAGE_GENERATE_PREAUTH_TOKENS=4000
# AINOBI_PROMPT_OPTIMIZE_CREDITS_SERVICE_CODE=
# 设计/内容模板提取（文本/视觉 LLM，TokenBased）；默认回退 AINOBI_PROMPT_OPTIMIZE_CREDITS_SERVICE_CODE
# AINOBI_DESIGN_TEMPLATE_EXTRACT_CREDITS_SERVICE_CODE=
# AINOBI_CONTENT_TEMPLATE_EXTRACT_CREDITS_SERVICE_CODE=

# Courseware Quiz AI 评测（由 courseware 服务直接执行）
# Provider: vertexai（有 GOOGLE_CLOUD_API_KEY 时用 API Key，否则用与旁白相同的服务账号）| openai（OpenAI Chat Completions 兼容）
# Gemini Developer API（gemini_api）已不再支持，配置成它会报错。
COURSEWARE_QUIZ_SCORING_PROVIDER=
COURSEWARE_QUIZ_TEXT_SCORING_PROVIDER=openai
COURSEWARE_QUIZ_AUDIO_SCORING_PROVIDER=vertexai
GOOGLE_CLOUD_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_OAUTH_ACCESS_TOKEN=
VERTEXAI_PROJECT_ID=
VERTEXAI_LOCATION=us-central1
VERTEXAI_MODEL=gemini-3.6-flash
COURSEWARE_QUIZ_SCORING_API_KEY=
COURSEWARE_QUIZ_SCORING_MODEL=gemini-3.6-flash
COURSEWARE_QUIZ_TEXT_SCORING_MODEL=gpt-4o-mini
COURSEWARE_QUIZ_AUDIO_SCORING_MODEL=gemini-3.6-flash
COURSEWARE_QUIZ_SCORING_BASE_URL=
COURSEWARE_QUIZ_TEXT_SCORING_BASE_URL=https://api.openai.com/v1
COURSEWARE_QUIZ_AUDIO_SCORING_BASE_URL=
COURSEWARE_QUIZ_SCORING_CREDITS_SERVICE_CODE=gemini-3.6-flash
COURSEWARE_QUIZ_TEXT_SCORING_CREDITS_SERVICE_CODE=gpt-4o-mini
COURSEWARE_QUIZ_AUDIO_SCORING_CREDITS_SERVICE_CODE=gemini-3.6-flash
# 仅当 audio provider=openai 时使用，转写会独立按 idempotency_key 扣费
COURSEWARE_QUIZ_TRANSCRIPTION_MODEL=whisper-1
COURSEWARE_QUIZ_TRANSCRIPTION_CREDITS_SERVICE_CODE=whisper-1
COURSEWARE_QUIZ_PROJECTION_RETRY_WORKER_ENABLED=true
COURSEWARE_QUIZ_PROJECTION_RETRY_INTERVAL_MS=60000
COURSEWARE_QUIZ_PROJECTION_RETRY_BATCH_SIZE=20

# AINOBI_DOC_READ_MAX_BYTES=104857600

# Tavily API Key（宿主进程 `POST /courseware/search/run`；agent 沙箱通过 `ainobi search` 委托，勿注入沙箱）
TAVILY_API_KEY=
# Agent 搜索：由 chat 注入 http://127.0.0.1:${PORT}/courseware/search/run（勿在沙箱手写）
# AINOBI_SEARCH_HOST_URL=http://127.0.0.1:5633/courseware/search/run
# AINOBI_SEARCH_HOST_TIMEOUT_MS=120000
# Agent 文档读取：由 chat 注入 http://127.0.0.1:${PORT}/courseware/doc/read（勿在沙箱手写）
# AINOBI_DOC_HOST_URL=http://127.0.0.1:5633/courseware/doc/read
# AINOBI_DOC_HOST_TIMEOUT_MS=300000
# Agent 图片复刻 HTML：由 chat 注入 http://127.0.0.1:${PORT}/courseware/image/replicate-html（勿在沙箱手写）
# AINOBI_IMAGE_REPLICATE_HOST_URL=http://127.0.0.1:5633/courseware/image/replicate-html
# AINOBI_IMAGE_REPLICATE_HOST_TIMEOUT_MS=300000
# Agent 文本生图：由 chat 注入 http://127.0.0.1:${PORT}/courseware/image/generate（勿在沙箱手写）
# AINOBI_IMAGE_GENERATE_HOST_URL=http://127.0.0.1:5633/courseware/image/generate
# AINOBI_IMAGE_GENERATE_HOST_TIMEOUT_MS=300000
# Agent AI 教师目录：由 chat 注入 http://127.0.0.1:${PORT}/courseware/ai-teachers/list（勿在沙箱手写）
# AINOBI_AI_TEACHERS_HOST_URL=http://127.0.0.1:5633/courseware/ai-teachers/list
# AINOBI_AI_TEACHERS_HOST_TIMEOUT_MS=60000

# Agent 最大对话轮次（工具调用步数），默认 40
AGENT_MAX_TURNS=40
# CLI help 注入 system prompt：slim（默认）| full | false
# CHAT_AINOBI_HELP_CONTEXT=slim
# Agent 归档 tool 结果召回：由 chat 注入 http://127.0.0.1:${PORT}/courseware/tool-result/recall
# AINOBI_TOOL_RESULT_RECALL_HOST_URL=http://127.0.0.1:5633/courseware/tool-result/recall
# Aliyun FC / nested Docker: weaker bwrap mode (on Linux defaults to true unless set false)
# AINOBI_AGENT_WEAKER_NESTED_SANDBOX=true
# Optional explicit paths when not on PATH: AINOBI_AGENT_BWRAP_PATH=/opt/bin/bwrap
# Linux/FC defaults OS sandbox off (Claude bwrap cannot init in nested containers). Force retry:
# AINOBI_AGENT_FORCE_SANDBOX=true
# Explicit off: AINOBI_AGENT_DISABLE_SANDBOX=true

# Agent 对外展示名称（回答「你是谁」等自我介绍；默认 AINOBI 课件助手）
# AINOBI_AGENT_DISPLAY_NAME=AINOBI 课件助手

# 可选：覆盖 Claude Code 原生 CLI 路径（FC/Linux 排障时可手动指定 glibc 版 claude 二进制）
# CLAUDE_CODE_EXECUTABLE=/code/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude

# 课件成品输出目录（本地单独跑 ainobi CLI 时可用）。本仓库的 /chat Agent 会为子进程设置 AINOBI_CLI_RUNTIME=agent 并清除 AINOBI_OUTPUT_DIR，不在磁盘上写 save 产物。
AINOBI_OUTPUT_DIR=output

# 数据库配置
DB_TYPE="postgres"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="123456"
DB_DATABASE="education"
DB_LOGGING=false

# Redis数据库配置
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_LAZY_CONNECT=false
REDIS_DB=0

# 课件版本：每次保存追加一条快照，最多保留最近 N 条（默认 10）
COURSEWARE_VERSION_MAX=15

# Aliyun OSS
OSS_REGION=ap-northeast-1
OSS_ENDPOINT=https://oss-ap-northeast-1.aliyuncs.com
OSS_BUCKET=example-courseware
OSS_STS_TOKEN=
OSS_SECURE=true
OSS_TIMEOUT=300s
OSS_MULTIPART_THRESHOLD_MB=1
OSS_MULTIPART_PART_SIZE_MB=1
OSS_MULTIPART_PARALLEL=3
OSS_PROXY=http://127.0.0.1:7890
# 浏览器/编辑器展示的公网对象 URL 前缀；预签名下载 URL 在 host 上会优先改用 OSS_ENDPOINT（VPC 内网）
OSS_PUBLIC_BASE_URL=https://example-courseware.oss-ap-northeast-1.aliyuncs.com

# AWS S3
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-northeast-1
AWS_S3_BUCKET_NAME=example-storage-bucket-dev
AWS_S3_URL_EXPIRES=3600