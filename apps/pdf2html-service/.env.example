PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=100
WORK_DIR=/tmp/ainobi-pdf2html-service
PDF2HTMLEX_PATH=pdf2htmlEX
# FC layer at /opt/usr/local (see scripts/build-fc-pdf2html-layer.sh):
# PDF2HTMLEX_PATH=/opt/usr/local/bin/pdf2htmlEX
# PDF2HTMLEX_DATA_DIR=/opt/usr/local/share/pdf2htmlEX
# PDF2HTMLEX_POPPLER_DATA_DIR=/opt/usr/local/share/pdf2htmlEX/poppler
PDFINFO_PATH=pdfinfo
PDF2HTML_TIMEOUT_MS=600000
PDF2HTMLEX_ZOOM=1.5
PDF2HTMLEX_EMBED_CSS=true
PDF2HTMLEX_EMBED_FONT=true
PDF2HTMLEX_EMBED_IMAGE=true
PDF2HTMLEX_EMBED_JAVASCRIPT=true
PDF2HTMLEX_EMBED_OUTLINE=true
PDF2HTMLEX_OPTIMIZE_TEXT=true
HTML_MINIFY=true
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
OSS_SECURE=true
OSS_TIMEOUT=300s
OSS_MULTIPART_THRESHOLD_MB=1
OSS_MULTIPART_PART_SIZE_MB=1
OSS_MULTIPART_PARALLEL=3
