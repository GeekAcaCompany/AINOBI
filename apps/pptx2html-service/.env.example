PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_FILE_SIZE_MB=100
PPTX_POOL_SIZE=2
RUNTIME_READY_TIMEOUT_MS=30000
PUPPETEER_EXECUTABLE_PATH="./.bin/chrome-headless-shell/chrome-headless-shell"
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
HTML_MINIFY=true
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
OSS_SECURE=true
OSS_TIMEOUT=300s
OSS_MULTIPART_THRESHOLD_MB=1
OSS_MULTIPART_PART_SIZE_MB=1
OSS_MULTIPART_PARALLEL=3
