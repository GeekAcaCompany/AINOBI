{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "server/**/*.test.ts", "scripts/**/*.test.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false
  }
}
