# 阿里云账户ID
ALIYUN_ACCOUNT_ID=5373477951171581
# 阿里云访问Key ID（在云函数上无需设置，会自动取系统提供的认证信息）
ALIYUN_ACCESS_KEY_ID=
# 阿里云访问Key Secret（在云函数上无需设置，会自动取系统提供的认证信息）
ALIYUN_ACCESS_KEY_SECRET=
# 阿里函数地域
ALIYUN_FC_REGION=ap-northeast-1
# 阿里云函数名称
ALIYUN_FC_FUNCTION_NAME=ainobi-video-render-service
# 阿里云函数别名（yarn release / release:prod → prod；yarn release:test → test）
ALIYUN_FC_FUNCTION_ALIAS=prod
# 也可通过 CLI 覆盖：node scripts/publish.js --alias test --version latest
# 阿里云函数生产域名（可以为多个，用逗号分隔）
ALIYUN_FC_PROD_DOMAIN=courseware-api.example.com
# 阿里云函数测试域名（可以为多个，用逗号分隔）
ALIYUN_FC_TEST_DOMAIN=courseware-api.example.com
# 阿里云函数路由路径（可以为多个，用逗号分隔）
# 智能体产品：/agent/[function_name]/*
# API产品：/api/[function_name]/*
# 大模型产品：/llm/[function_name]/*
ALIYUN_FC_ROUTE_PATH=/interaction/*

# 指定时区
TZ=Asia/Shanghai

# 服务端口
PORT=5633

# MiniMax TTS
MINIMAX_API_KEY=
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Gentleman
# Fish Audio TTS
# Fish Audio TTS（ai_teacher_tts.tts_provider=fishaudio 时使用）
FISH_AUDIO_API_KEY=
# FISH_AUDIO_TTS_MODEL=s1
# FISH_AUDIO_TTS_VOICE_ID=
# FISH_AUDIO_TTS_URL=https://api.fish.audio/v1/tts
# Agent 旁白 TTS：由 chat 注入 http://127.0.0.1:${PORT}/courseware/narration/run（勿在沙箱手写）
# AINOBI_NARRATION_HOST_URL=http://127.0.0.1:5633/courseware/narration/run
# AINOBI_NARRATION_HOST_TIMEOUT_MS=600000
# Live preview scene.patch 合并窗口（毫秒，默认 250；0=每条 ainobi 命令立即 flush）
# AINOBI_LIVE_PREVIEW_FLUSH_DEBOUNCE_MS=250
# managed_list 结果 Redis 缓存秒数（默认 300）
# AINOBI_ORG_MANAGED_LIST_CACHE_TTL_SECONDS=300

# 浏览器跨域（课件编辑器 localhost 等）；默认 *。业务请求仍需 Authorization: Bearer <access_token>
# CORS_ALLOW_ORIGIN=http://localhost:5173
# CORS_ALLOW_HEADERS=content-type, authorization, accept, x-requested-with

# Claude Code API 模型配置
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4.1-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Vision API Key（宿主 `POST /courseware/doc/read` 图片→Markdown 描述；`POST /courseware/image/replicate-html` 图片→HTML 复刻；agent 通过 `ainobi doc read` / `ainobi image replicate-html` 委托，勿注入沙箱）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_API_BASE=https://api.openai.com/v1

# AINOBI_DOC_READ_MAX_BYTES=104857600

# Tavily API Key（宿主进程 `POST /courseware/search/run`；agent 沙箱通过 `ainobi search` 委托，勿注入沙箱）
TAVILY_API_KEY=
# Agent 搜索：由 chat 注入 http://127.0.0.1:${PORT}/courseware/search/run（勿在沙箱手写）
# AINOBI_SEARCH_HOST_URL=http://127.0.0.1:5633/courseware/search/run
# AINOBI_SEARCH_HOST_TIMEOUT_MS=120000
# Agent 文档读取：由 chat 注入 http://127.0.0.1:${PORT}/courseware/doc/read（勿在沙箱手写）
# AINOBI_DOC_HOST_URL=http://127.0.0.1:5633/courseware/doc/read
# AINOBI_DOC_HOST_TIMEOUT_MS=300000
# Agent 图片复刻 HTML：由 chat 注入 http://127.0.0.1:${PORT}/courseware/image/replicate-html（勿在沙箱手写）
# AINOBI_IMAGE_REPLICATE_HOST_URL=http://127.0.0.1:5633/courseware/image/replicate-html
# AINOBI_IMAGE_REPLICATE_HOST_TIMEOUT_MS=300000
# Agent AI 教师目录：由 chat 注入 http://127.0.0.1:${PORT}/courseware/ai-teachers/list（勿在沙箱手写）
# AINOBI_AI_TEACHERS_HOST_URL=http://127.0.0.1:5633/courseware/ai-teachers/list
# AINOBI_AI_TEACHERS_HOST_TIMEOUT_MS=60000

# Agent 最大对话轮次（工具调用步数），默认 200
AGENT_MAX_TURNS=200

# Gemini Live（与 e-learning-platform-education app/config.py 对齐）
GOOGLE_CLOUD_API_KEY=
# GEMINI_API_KEY=  # 若设置则优先于 GOOGLE_CLOUD_API_KEY
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_API_VERSION=v1beta
GEMINI_LIVE_VOICE=Zubenelgenubi
# dictation 转写语种（中/日/英）由 systemInstruction 约束（Developer API 不支持 languageCodes）
# conversation 模式服务端 PCM 门控；dictation 由前端 VAD 负责，服务端自动跳过
# GEMINI_LIVE_AUDIO_GATE_ENABLED=true
# GEMINI_LIVE_AUDIO_GATE_PEAK_THRESHOLD=256
# GEMINI_LIVE_AUDIO_GATE_TAIL_CHUNKS=4

# Aliyun FC / nested Docker: weaker bwrap mode (on Linux defaults to true unless set false)
# AINOBI_AGENT_WEAKER_NESTED_SANDBOX=true
# Optional explicit paths when not on PATH: AINOBI_AGENT_BWRAP_PATH=/opt/bin/bwrap
# Linux/FC defaults OS sandbox off (Claude bwrap cannot init in nested containers). Force retry:
# AINOBI_AGENT_FORCE_SANDBOX=true
# Explicit off: AINOBI_AGENT_DISABLE_SANDBOX=true

# Agent 对外展示名称（回答「你是谁」等自我介绍；默认 AINOBI 课件助手）
# AINOBI_AGENT_DISPLAY_NAME=AINOBI 课件助手

# 可选：覆盖 Claude Code 原生 CLI 路径（FC/Linux 排障时可手动指定 glibc 版 claude 二进制）
# CLAUDE_CODE_EXECUTABLE=/code/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude

# 视频渲染本地输出目录（MP4 始终写入此目录）。相对路径相对于项目根目录解析；
# 也可填绝对路径。部署到 Aliyun FC 时必须显式设为 /tmp 下的绝对路径（代码包目录只读），
# 例如 AINOBI_OUTPUT_DIR=/tmp/output —— 见 s.prod.yaml.example。
AINOBI_OUTPUT_DIR=output
# 渲染完成后是否自动上传到 OSS（本地调试可设为 false）
AINOBI_VIDEO_RENDER_OSS_UPLOAD=true
# 视频渲染产物 OSS bucket（默认 example-video-render-output）
# OSS_BUCKET=example-video-render-output
# 视频渲染产物公网 URL 前缀（未设置时由 bucket + OSS_ENDPOINT 推导）
# AINOBI_VIDEO_RENDER_OSS_PUBLIC_BASE_URL=https://example-video-render-output.oss-ap-northeast-1.aliyuncs.com
# 默认渲染参数（请求体未传时使用）
# AINOBI_VIDEO_RENDER_WIDTH=1920
# AINOBI_VIDEO_RENDER_HEIGHT=1080
# AINOBI_VIDEO_RENDER_FPS=30
# AINOBI_VIDEO_RENDER_DURATION_MS=10000
# 是否输出页面 console 日志
# AINOBI_VIDEO_RENDER_CONSOLE_LOG=false
# Hyperframes 渲染无头浏览器：本地会自动探测/下载 Chromium，Aliyun FC 上没有可下载的浏览器，
# 必须通过自定义层提供二进制并在此显式指定路径（同时会写入 Hyperframes 自身读取的
# PRODUCER_HEADLESS_SHELL_PATH，见 src/config/video-render.ts#ensureHyperframesBrowserEnv）。
# AINOBI_VIDEO_RENDER_BROWSER_EXECUTABLE=/opt/chrome-headless-shell/chrome-headless-shell
# AINOBI_VIDEO_RENDER_BROWSER_USE_GPU=false
# AINOBI_VIDEO_RENDER_PREPARE_TIMEOUT_MS=10000
# ffmpeg / ffprobe（本地需装在 PATH 上；FC 上需自定义层 + 显式指定路径）
# HYPERFRAMES_FFMPEG_PATH=/opt/ffmpeg/ffmpeg
# HYPERFRAMES_FFPROBE_PATH=/opt/ffmpeg/ffprobe
# SSRF 防护：仅允许渲染这些域名（含子域名，逗号分隔）；未设置时仅拦截内网/私有/保留地址
# AINOBI_VIDEO_RENDER_ALLOWED_HOSTS=app.example.com
# 本地联调：允许渲染 localhost / 内网地址（默认禁止）。生产环境切勿开启。
# AINOBI_VIDEO_RENDER_ALLOW_PRIVATE_URLS=true
# HTTP 请求体大小上限（字节，默认 1000000）
# AINOBI_HTTP_MAX_BODY_BYTES=1000000
# 接收请求头/请求体的超时（毫秒；不影响渲染耗时，只影响客户端上传阶段）
# AINOBI_HTTP_REQUEST_TIMEOUT_MS=30000
# AINOBI_HTTP_HEADERS_TIMEOUT_MS=60000

# courseware-agent 的 /courseware/render/callback 时携带的令牌）。
AINOBI_VIDEO_RENDER_INTERNAL_TOKEN=<set-from-vault VIDEO-RENDER-INTERNAL-TOKEN>
# 视频导出任务（/render/tasks*）：create/retry 立即返回 queued；随后调度阻塞的
# POST /render/tasks/:id/run —— FC 上用 X-Fc-Invocation-Type: Async + ainobi-render-task-id
# 自调用；本地则进程内 fire-and-forget。客户端 create 时必须带 ainobi-render-task-id UUID。
#
# FC 双函数部署（同一套代码，AINOBI_VIDEO_RENDER_FUNCTION_ROLE 区分）：
# - query：无亲和、高并发 — create/list/get/delete/retry（+ GET /health）
# - render：会话亲和 + instanceConcurrency=1 — run/cancel（+ POST /render/video）
# 本地开发不设 FUNCTION_ROLE（默认 all，单进程承载全部路由）。
#
# 渲染函数对外 base URL（query 创建/重试后 Async 调用 render 的 /run 用；query 函数必填）：
# AINOBI_VIDEO_RENDER_RENDER_BASE_URL=https://<render-function-http-trigger>
# 兼容旧名（未设置 RENDER_BASE_URL 时回退）：
# AINOBI_VIDEO_RENDER_SELF_BASE_URL=https://<render-function-http-trigger>
# 单个任务最多允许重试次数，防止永久失败的任务被无限重试（默认 3）
AINOBI_VIDEO_RENDER_TASK_MAX_RETRIES=3
# running 状态任务心跳超过此时长未更新，视为其所在实例已失联，启动时标记为 interrupted（毫秒，默认 300000）
AINOBI_VIDEO_RENDER_STALE_HEARTBEAT_MS=300000
# 与 s.*.yaml 中 render 函数 timeout（秒）对齐的毫秒值；用于软超时 abort 与孤儿任务超时失败（默认 28800000 = 28800s）
# AINOBI_VIDEO_RENDER_FC_TIMEOUT_MS=28800000
# 相对 FC 硬杀提前多久 abort，以便写 failed + 发 callback（默认 120000 = 2min）
# AINOBI_VIDEO_RENDER_SOFT_TIMEOUT_BUFFER_MS=120000
# query 实例定时扫孤儿 running 任务的间隔（毫秒，默认 60000）
# AINOBI_VIDEO_RENDER_ORPHAN_RECONCILE_INTERVAL_MS=60000
# 超长课件：plan → N 个 FC 实例 renderChunk → assemble（默认开启）
# AINOBI_VIDEO_RENDER_DISTRIBUTED_ENABLED=true
# 达到该帧数才 fan-out（默认 3000 ≈ 100s@30fps）；更短仍走单实例 forceScreenshot
# AINOBI_VIDEO_RENDER_DISTRIBUTED_MIN_FRAMES=3000
# 每 chunk 帧数（默认 900 ≈ 30s@30fps）；显式值优先于 maxParallel 自动均分
# AINOBI_VIDEO_RENDER_CHUNK_SIZE=900
# 单任务最多并行 chunk 实例数（默认 8）
# AINOBI_VIDEO_RENDER_MAX_PARALLEL_CHUNKS=8
# 每个 chunk 实例内的 Hyperframes workers（默认 2，避免 8GB 内存打满）
# AINOBI_VIDEO_RENDER_CHUNK_WORKERS=2
# 是否上传 OSS
AINOBI_VIDEO_RENDER_OSS_UPLOAD=true
# OSS 桶名
AINOBI_VIDEO_RENDER_OSS_BUCKET=example-video-render-output

# 数据库配置
DB_TYPE="postgres"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="123456"
DB_DATABASE="education"
DB_LOGGING=false

# Redis数据库配置
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_LAZY_CONNECT=false
REDIS_DB=0

# 课件版本：每次保存追加一条快照，最多保留最近 N 条（默认 10）
COURSEWARE_VERSION_MAX=15

# Aliyun OSS
OSS_REGION=ap-northeast-1
# 显式 endpoint 优先级最高（会覆盖 OSS_INTERNAL）。留空并配合 OSS_INTERNAL=true
# 即可让 SDK 自动拼出内网域名 oss-<region>-internal.aliyuncs.com。
OSS_ENDPOINT=https://oss-ap-northeast-1.aliyuncs.com
OSS_BUCKET=example-video-render-output
OSS_STS_TOKEN=
OSS_SECURE=true
# 上传产物走 OSS 内网（仅同区域 ECS/FC 可达；免公网流量费、更快）。
# 生产（FC 与 OSS 同区域）建议置 true 并清空 OSS_ENDPOINT，让 SDK 走 *-internal 域名。
# 别名：OSS_INTERNAL。返回给调用方的公网 URL 仍由 OSS_PUBLIC_BASE_URL / 公网 endpoint 推导，不受影响。
# 容错：内网上传若报网络类错误（DNS/连接/超时），会自动退回公网 endpoint 重试一次并记录 warning；
# 同一进程内该 bucket 后续上传直接走公网，不再重试内网（见 oss-upload.ts `isLikelyNetworkError`）。
# 非网络类错误（鉴权失败、bucket 不存在等）不会重试——换 endpoint 也解决不了，直接快速失败。
AINOBI_VIDEO_RENDER_OSS_INTERNAL=false
OSS_TIMEOUT=300s
OSS_MULTIPART_THRESHOLD_MB=1
OSS_MULTIPART_PART_SIZE_MB=1
OSS_MULTIPART_PARALLEL=3
OSS_PROXY=http://127.0.0.1:7890
# 浏览器/编辑器展示的公网对象 URL 前缀；预签名下载 URL 在 host 上会优先改用 OSS_ENDPOINT（VPC 内网）
OSS_PUBLIC_BASE_URL=https://example-video-render-output.oss-ap-northeast-1.aliyuncs.com

# AWS S3
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-northeast-1
AWS_S3_BUCKET_NAME=example-storage-bucket-dev
AWS_S3_URL_EXPIRES=3600