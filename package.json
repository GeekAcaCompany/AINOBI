  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeekAcaCompany/AINOBI.git"
  },
  "type": "module",
  "description": "Courseware authoring, playback, and avatars you can run with Node.js alone or embed piece by piece.",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node apps/studio/server/bootstrap.mjs",
    "add": "node scripts/add.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "lint:commits": "commitlint",
    "lint:commits:ci": "node scripts/check-commits.mjs",
    "test:commits": "node --test scripts/check-commits.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@types/node": "22.20.5",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@hyperframes/engine": "0.7.39",
      "three": "0.184.0"
    }
  }
}
