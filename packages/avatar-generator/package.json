{
  "name": "@ainobi/avatar-generator",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "type": "module",
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "avatar-generator"
    ]
  },
  "description": "Generates an Inochi2D avatar from a text description, with an image model and visual quality checks.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "licenses",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "openai": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
