{
  "name": "@ainobi/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "type": "module",
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "db"
    ],
    "origin": "adopted"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "description": "Database kernel: the TypeORM DataSource and Redis client factories (connection settings and entities come from the host), the UUID/timestamp insert subscriber, and nested-transaction joining for single-session databases.",
  "scripts": {
    "typecheck": "tsc -p .",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:adopt": "node scripts/migrate.mjs adopt",
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.23",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "ioredis": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
