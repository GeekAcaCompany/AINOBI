{
  "name": "@ainobi/storage-impl",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud storage implementations: Aliyun OSS and S3-compatible (OCI Object Storage), adopted from the backend's unified client with the Python-parity presigned URL formats.",
  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./signing.ts": "./src/signing.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./signing": {
        "types": "./dist/signing.d.ts",
        "import": "./dist/signing.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node ../../scripts/build-package.mjs"
  },
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "storage",
      "aliyun-oss",
      "oci-s3"
    ],
    "origin": "adopted"
  },
  "dependencies": {
    "@ainobi/api-contracts": "workspace:0.1.0",
    "@ainobi/storage": "workspace:0.1.0",
    "ali-oss": "^6.23.0",
    "@aws-sdk/client-s3": "^3.1054.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ali-oss": "^6.16.0"
  }
}
