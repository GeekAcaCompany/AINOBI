{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/*.d.mts"
  ],
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "resolveJsonModule": true,
    "noEmit": true
  }
}
