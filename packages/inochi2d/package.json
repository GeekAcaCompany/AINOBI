{
  "name": "inochi2d",
  "version": "0.0.0",
  "description": "Vendored build of Inochi2D/inochi2d-ts (three.js as peer dependency). Rebuild: clone repo, set vite rollupOptions.external: [\"three\"], npm run build, copy dist/.",
  "type": "module",
  "license": "BSD-2-Clause",
  "main": "./dist/inochi2d.es.js",
  "module": "./dist/inochi2d.es.js",
  "exports": {
    ".": {
      "types": "./inochi2d.d.ts",
      "import": "./dist/inochi2d.es.js",
      "require": "./dist/inochi2d.umd.js"
    }
  },
  "peerDependencies": {
    "three": "^0.146.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "licenses",
    "inochi2d.d.ts"
  ],
  "private": true,
  "author": "Inochi2D contributors",
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "inochi2d"
    ],
    "origin": "adopted"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  },
  "types": "./inochi2d.d.ts"
}
