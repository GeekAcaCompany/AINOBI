{
  "name": "@ainobi/tts-fishaudio",
  "version": "0.1.0",
  "private": true,
  "description": "The fishaudio implementation of the tts capability port, adopted from the platform backend.",
  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node ../../scripts/build-package.mjs"
  },
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "tts",
      "fishaudio"
    ],
    "origin": "adopted"
  },
  "dependencies": {
    "@ainobi/api-contracts": "workspace:0.1.0",
    "@ainobi/tts": "workspace:0.1.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
