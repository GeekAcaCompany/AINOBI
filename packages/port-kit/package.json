{
  "name": "@ainobi/port-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared building blocks of the capability ports: the not-configured error and the provider registry that @ainobi/tts, @ainobi/llm, @ainobi/storage and @ainobi/doc-converter are built on.",
  "license": "AGPL-3.0-only",
  "author": "GeekAca Ltd.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node ../../scripts/build-package.mjs"
  },
  "ainobi": {
    "visibility": "public",
    "capabilities": [
      "port-kit"
    ]
  }
}
